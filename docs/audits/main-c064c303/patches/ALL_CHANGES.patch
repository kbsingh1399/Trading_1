+def test_footprint_jsonl_emits_only_closed_enriched_signals(tmp_path, monkeypatch):
+    mod = importlib.import_module("1_coinglass_footprint_scraper")
+    monkeypatch.setattr(mod, "SIGNALS_PARQUET", tmp_path / "signals.parquet")
+    monkeypatch.setattr(mod, "SIGNALS_JSONL", tmp_path / "footprint_signals.jsonl")
+    monkeypatch.setattr(mod, "KNOWN_SIGNAL_KEYS", set())
+    now_ms = int(time.time() * 1000)
+    closed_open = ((now_ms - 1_800_000) // 900_000) * 900_000
+    forming_open = (now_ms // 900_000) * 900_000
+    signals = [
+        {"symbol": "BTC", "sig_code": "abs", "time_ms": closed_open, "price": 100.0},
+        {"symbol": "BTC", "sig_code": "trap", "time_ms": forming_open, "price": 101.0},
+    ]
+    new = mod.dump_signals(signals)
+    assert [s["sig_code"] for s in new] == ["abs"]
+    lines = [json.loads(x) for x in mod.SIGNALS_JSONL.read_text().splitlines()]
+    assert len(lines) == 1
+    assert lines[0]["bar_closed"] is True
+    assert lines[0]["source"] == "coinglass_cdp"
+    assert lines[0]["open_time_ist"]
+    # Second sweep must not re-emit the closed signal.
+    assert mod.dump_signals(signals) == []
+
+
+def test_tv_summary_uses_latest_closed_bar_and_aliases(tmp_path, monkeypatch):
+    mod = importlib.import_module("4_coinglass_tv_scraper")
+    monkeypatch.setattr(mod, "LIVE_LIQ_DIR", tmp_path)
+    now_s = int(time.time())
+    closed_open = ((now_s - 1800) // 900) * 900
+    forming_open = (now_s // 900) * 900
+    rows = []
+    for i in range(12):
+        t = closed_open - (11 - i) * 900
+        rows.append([t, 1000.0, 1000.0])
+    rows.append([closed_open, 900000.0, 100000.0])  # closed spike
+    rows.append([forming_open, 1.0, 1.0])           # forming noise must not drive summary
+    summary = mod.process_and_persist("BTC", "BTCUSDT", rows, last_price=100.0)
+    assert summary is not None
+    assert summary["bar_closed"] is True
+    assert summary["candle_open_ms"] == closed_open * 1000
+    assert summary["recent_spike"] is True
+    assert summary["latest_long_liq_usd"] == 900000.0
+    assert summary["reversal_bias"] == "BULLISH_REVERSAL"
