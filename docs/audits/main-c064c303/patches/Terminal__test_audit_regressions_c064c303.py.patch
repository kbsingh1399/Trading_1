+"""Offline regression tests for the main@c064c303 audit patch bundle.
+
+These tests do not attach to CDP, rotate WARP, connect to a broker, or place
+orders. They exercise the fail-closed invariants introduced by the audit patch.
+"""
+import asyncio
+import importlib
+import json
+import time
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+
+def test_evaluator_imports_and_no_storage_side_effect_dispatch():
+    mod = importlib.import_module("Terminal.realtime_signal_evaluator")
+    src = Path(mod.__file__).read_text(encoding="utf-8")
+    assert "execute_mt5_signal(alert)" not in src
+    assert "loop.create_task(execute_signal(alert))" not in src
+
+
+def test_matchtrader_constants_and_dispatch_fail_closed():
+    from Terminal import matchtrader_live_trader as mt
+    from Terminal.risk_envelope import HARD_FLOOR_USD, MAX_RISK_USD, MAX_OPEN_POSITIONS
+    assert mt.INITIAL_BALANCE == 5000.0
+    assert mt.EQUITY_FLOOR_TOTAL == HARD_FLOOR_USD == 4775.0
+    assert mt.DEFAULT_RISK_PER_TRADE_USD == MAX_RISK_USD == 25.0
+    assert mt.MAX_CONCURRENT_POSITIONS == MAX_OPEN_POSITIONS == 2
+    assert mt.LIVE_DISPATCH_ENABLED is False
+    res = asyncio.run(mt.execute_market_order(None, "BUY", 0.01, "BTCUSD", 1.0, 2.0))
+    assert res["ok"] is False and res["status"] == "REJECTED"
+
+
+def test_risk_budget_rejects_nonfinite_and_cap_above_mandate():
+    from Terminal.risk_envelope import budget_per_trade, admissible_volume
+    assert budget_per_trade(float("nan"), 5000.0)[1] is False
+    assert budget_per_trade(5000.0, 5000.0, committed_stress_usd=-1.0)[1] is False
+    lots, reason, risk = admissible_volume(loss_per_lot_step=1.0, cap_usd=500.0)
+    assert lots is None and "CAP_ABOVE_MANDATE" in reason and risk == 0.0
+
+
+def test_writer_lock_inode_is_persistent(tmp_path):
+    from Terminal.runtime_io import writer_lock
+    target = tmp_path / "x.parquet"
+    with writer_lock(target):
+        lock_path = Path(str(target) + ".writer.lock")
+        assert lock_path.exists()
+        inode = lock_path.stat().st_ino
+    assert lock_path.exists()
+    assert lock_path.stat().st_ino == inode
+
+
+def test_completed_candles_rejects_internal_gap():
+    from Terminal.runtime_io import completed_candles
+    now = 1_800_000_000_000
+    frame = pd.DataFrame({
+        "open_time_ms": [now - 2_700_000, now - 900_000],
+        "close_time_ms": [now - 1_800_000, now],
+    })
+    with pytest.raises(ValueError):
+        completed_candles(frame, now)
+
+
+def test_warp_rotation_blocked_by_order_mutex(tmp_path, monkeypatch):
+    from Terminal import collector_lock as cl
+    from Terminal.runtime_io import FileMutex
+    monkeypatch.setattr(cl, "LOCK_DIR", tmp_path)
+    monkeypatch.setattr(cl, "WARP_ROTATION_FILE", tmp_path / "warp_last_rotation.json")
+    monkeypatch.setattr(cl, "WARP_CLI", tmp_path / "warp-cli.exe")
+    cl.WARP_CLI.write_text("")
+    monkeypatch.setattr(cl, "get_current_ip", lambda: "203.0.113.10")
+    called = []
+    monkeypatch.setattr(cl.subprocess, "run", lambda *a, **k: called.append(a))
+    with FileMutex(str(tmp_path / "order_execution_inflight.lock"), timeout=0.0) as guard:
+        assert guard.acquired
+        ip = cl.rotate_warp_ip("Test", reason="CHALLENGE", force=True)
+    assert ip == "203.0.113.10"
+    assert called == []
+
+
+def test_whale_walls_apply_exponential_decay(tmp_path, monkeypatch):
+    from Terminal import olap_engine
+    from Terminal.collector_lock import calculate_wall_decay_weight
+    now = pd.Timestamp.now(tz="UTC")
+    open_dir = tmp_path / "Open_Orders"
+    open_dir.mkdir()
+    frame = pd.DataFrame({
+        "symbol": ["BTC", "BTC"],
+        "side": ["bid", "ask"],
+        "price": [100.0, 101.0],
+        "from_price_pct": [0.0, 1.0],
+        "remaining_usd": [100.0, 100.0],
+        "duration_seconds": [0.0, 3600.0],
+        "snapshot_time_utc": [now.isoformat(), now.isoformat()],
+    })
+    frame.to_parquet(open_dir / "BTC_whale_open_orders.parquet", index=False)
+    monkeypatch.setattr(olap_engine, "OPEN_ORDERS_DIR", open_dir)
+    engine = olap_engine.OlapEngine()
+    try:
+        res = engine.query_whale_walls("BTC")
+    finally:
+        engine.close()
+    assert res["data_valid"] is True
+    expected_ask = 100.0 * calculate_wall_decay_weight(3600.0)
+    assert res["tight_ask_walls_usd"] == pytest.approx(expected_ask, rel=1e-3)
+    assert res["tight_bid_walls_usd"] == pytest.approx(100.0, rel=1e-3)
+    assert res["whale_imbalance_bid_ratio"] > 0.7
+
+
